{
  "version": 3,
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default (Visual Studio)",
      "description": "Uses the newest installed Visual Studio generator",
      "binaryDir": "${sourceDir}/build"
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "default",
      "configuration": "Debug"
    },
    {
      "name": "release",
      "configurePreset": "default",
      "configuration": "Release"
    }
  ]
}
